# Copy to .env.local after generating an admin key:
#   docker compose exec backend ./generate_admin_key.sh
CONVEX_SELF_HOSTED_ADMIN_KEY="<admin-key>"
CONVEX_SELF_HOSTED_URL="http://127.0.0.1:3210"
VITE_CONVEX_URL="http://127.0.0.1:3210"
VITE_CONVEX_SITE_URL="http://127.0.0.1:3211"

# Optional: direct human-chat service (default uses Vite proxy /chat-api → :8791)
# VITE_CHAT_API_URL=/chat-api
# CHAT_SERVER_PORT=8791
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5

# --- Convex Auth v1 (set on the Convex deployment via `npx convex env set`) ---
# Frontend origin for magic-link redirects (note Vite base /ai-town):
#   npx convex env set SITE_URL http://localhost:5173/ai-town
# Resend API key + optional from-address:
#   npx convex env set AUTH_RESEND_KEY re_xxxxxxxx
#   npx convex env set AUTH_EMAIL "伊甸园 <onboarding@resend.dev>"
# JWT keys (run: node scripts/generateAuthKeys.mjs, then set both):
#   npx convex env set JWT_PRIVATE_KEY "..."
#   npx convex env set JWKS "..."
